@model ViewLayer.Models.LoginViewModel

@{
    ViewData["Title"] = "Inloggen";
}

<div class="signup-wrapper">
    <div class="signup-card">
        <h2 class="signup-title">Inloggen</h2>
        <p class="signup-subtitle">Vul je gegevens in om in te loggen</p>

        <form asp-controller="Login" asp-action="Login" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Username">Gebruikersnaam</label>
                <input asp-for="Username" class="form-control" placeholder="Jouw gebruikersnaam" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">Wachtwoord</label>
                <input asp-for="Password" class="form-control" type="password" placeholder="Jouw wachtwoord" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-submit">Inloggen</button>

            <p class="signup-login-link">
                Nog geen account? <a asp-controller="SignUp" asp-action="SignUp">Aanmelden</a>
            </p>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}