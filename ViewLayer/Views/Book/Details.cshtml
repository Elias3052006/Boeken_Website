@model ViewLayer.Models.BookDetailViewModel
@using Microsoft.AspNetCore.Http;

@{
    ViewData["Title"] = Model.Title;
    var username = Context.Session.GetString("Username");
}

<div class="book-detail-wrapper">
    <div class="book-detail-card">
        <div class="book-detail-cover">
            <p class="book-detail-placeholder">📖</p>
        </div>

        <div class="book-detail-info">
            <h1 class="book-detail-title">@Model.Title</h1>
            <p class="book-detail-author">door @Model.Author</p>
            <p class="book-detail-price">€@Model.Price</p>
            <p class="book-detail-description">@Model.Description</p>

            @if (Model.IsAvailable)
            {
                <p class="book-detail-stock stock-available">Op voorraad (@Model.Stock stuks)</p>

                @if (username != null)
                {
                    <a asp-controller="Order" asp-action="Create" asp-route-id="@Model.BookId" class="btn-submit book-detail-btn">
                        Toevoegen aan bestelling
                    </a>

                    <form asp-controller="Loan" asp-action="Create" method="post" style="margin-top: 10px;">
                        <input type="hidden" name="bookId" value="@Model.BookId" />
                        <button type="submit" class="btn-submit book-detail-btn" style="background-color: #28a745;">
                            Boek Lenen
                        </button>
                    </form>

                    <div style="margin-top: 15px;">
                        <a asp-controller="Loan" asp-action="Index" style="text-decoration: underline; color: #555;">
                            Bekijk mijn leningenoverzicht
                        </a>
                    </div>
                }
                else
                {
                    <a asp-controller="Login" asp-action="Login"
                       asp-route-returnUrl="@Url.Action("AddBook", "Order", new { id = Model.BookId })"
                       class="btn-submit book-detail-btn">
                        Inloggen om te bestellen/lenen
                    </a>
                }
            }
            else
            {
                <p class="book-detail-stock stock-unavailable">Niet op voorraad</p>
            }

            <a asp-controller="Home" asp-action="Index" class="book-detail-back">← Terug naar home</a>
        </div>
    </div>
</div>