@model ViewLayer.Models.BookViewModel

@{
    ViewData["Title"] = "Boek toevoegen";
}

<div class="signup-wrapper">
    <div class="signup-card">
        <h2 class="signup-title">Boek toevoegen</h2>
        <p class="signup-subtitle">Vul de gegevens in om een boek toe te voegen</p>

        <form asp-controller="Book" asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Title">Titel</label>
                <input asp-for="Title" class="form-control" placeholder="Titel van het boek" />
            </div>

            <div class="form-group">
                <label asp-for="Author">Auteur</label>
                <input asp-for="Author" class="form-control" placeholder="Naam van de auteur" />
            </div>

            <div class="form-group">
                <label asp-for="Description">Beschrijving</label>
                <textarea asp-for="Description" class="form-control" placeholder="Beschrijving van het boek" rows="3"></textarea>
            </div>

            <div class="form-row">
                <div class="form-group col-7">
                    <label asp-for="Price">Prijs (€)</label>
                    <input asp-for="Price" class="form-control" placeholder="0.00" type="number" step="0.01" />
                </div>
                <div class="form-group col-5">
                    <label asp-for="Stock">Voorraad</label>
                    <input asp-for="Stock" class="form-control" placeholder="0" type="number" />
                </div>
            </div>

            <div class="form-group">
                <label asp-for="CategoryId">Categorie</label>
                <select asp-for="CategoryId" class="form-control">
                    <option value="">-- Kies een categorie --</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.CategoryId">@cat.CategoryName</option>
                    }
                </select>
            </div>

            <button type="submit" class="btn-submit">Boek toevoegen</button>

            <p class="signup-login-link">
                <a asp-controller="Home" asp-action="Index">Terug naar home</a>
            </p>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
